import unittest

from calc_logic import calculate, format_result


class TestCalculate(unittest.TestCase):

    def test_addition(self):
        self.assertEqual(calculate(2, 3, "+"), 5)

    def test_subtraction(self):
        self.assertEqual(calculate(10, 4, "-"), 6)

    def test_multiplication(self):
        self.assertEqual(calculate(6, 7, "*"), 42)

    def test_division(self):
        self.assertEqual(calculate(9, 2, "/"), 4.5)

    def test_division_by_zero_raises(self):
        with self.assertRaises(ZeroDivisionError):
            calculate(5, 0, "/")

    def test_modulo(self):
        self.assertEqual(calculate(10, 3, "%"), 1)

    def test_modulo_by_zero_raises(self):
        with self.assertRaises(ZeroDivisionError):
            calculate(5, 0, "%")

    def test_unknown_operator_raises(self):
        with self.assertRaises(ValueError):
            calculate(1, 2, "^")

    def test_negative_numbers(self):
        self.assertEqual(calculate(-5, 3, "+"), -2)


class TestFormatResult(unittest.TestCase):

    def test_whole_number_has_no_decimal(self):
        self.assertEqual(format_result(4.0), "4")

    def test_decimal_number_kept(self):
        self.assertEqual(format_result(4.5), "4.5")

    def test_long_decimal_rounded(self):
        self.assertEqual(format_result(1 / 3), "0.33333333")

    def test_negative_whole_number(self):
        self.assertEqual(format_result(-7.0), "-7")


if __name__ == "__main__":
    unittest.main()
